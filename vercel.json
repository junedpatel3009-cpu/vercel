{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "env": {
    "SKIP_ENV_VALIDATION": "true"
  },
  "functions": {
    "api/ssr.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr"
    }
  ]
}
